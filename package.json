{
	"name": "sysify",
	"version": "0.1.0-beta.2",
	"description": "A Lightweight, TypeScript-Powered File System for Node.js",
	"type": "commonjs",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist/",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist && tsc",
		"dev": "LOG_LEVEL=debug tsx watch src/test.ts",
		"lint": "eslint src/ tests/ --max-warnings=5",
		"lint:fix": "eslint src/ tests/ --fix",
		"format": "prettier --write src/ tests/",
		"format:check": "prettier --check src/ tests/",
		"validate": "npm run type-check && npm run lint && npm run format:check",
		"test": "LOG_LEVEL=off jest",
		"test:coverage": "LOG_LEVEL=off jest --coverage",
		"test:watch": "LOG_LEVEL=off jest --watch",
		"type-check": "tsc --noEmit",
		"prepublishOnly": "npm run validate && npm test",
		"publish:beta": "npm version prerelease --preid=beta && npm publish --tag beta",
		"prepack": "npm run build"
	},
	"keywords": [
		"sysify",
		"filesystem",
		"nodejs",
		"typescript",
		"file",
		"directory",
		"fs",
		"path",
		"read",
		"write",
		"delete",
		"copy",
		"move",
		"rename",
		"watch",
		"watcher",
		"watching"
	],
	"author": "Abdellah Allali <hi+sysify@allali.me>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aallali/Sysify.git"
	},
	"bugs": {
		"url": "https://github.com/aallali/Sysify/issues"
	},
	"homepage": "https://github.com/aallali/Sysify#readme",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.19.0",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/jest": "30.0.0",
		"@types/node": "20.19.43",
		"@types/tmp": "0.2.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"jest": "30.5.2",
		"prettier": "3.9.10",
		"tmp": "0.2.7",
		"ts-jest": "29.4.15",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1"
	},
	"pnpm": {
		"overrides": {
			"glob@>=9 <14.0.2": "14.0.4",
			"minimatch@>=7 <11.0.1": "11.0.5"
		},
		"auditConfig": {
			"ignoreGhsas": [
				"GHSA-gcqx-w48m-w2h4"
			]
		}
	}
}
